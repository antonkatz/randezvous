{
  "name": "rdz",
  "version": "1.0.0",
  "description": "A permissionless peer-to-peer rendezvous board with direct image and one-minute voice.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -P -n web,seed -c cyan,magenta \"vite {@}\" \"tsx watch server/index.ts\" --",
    "dev:web": "vite",
    "dev:seed": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:app && npm run build:server",
    "build:app": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --external:ws --sourcemap",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview"
  },
  "keywords": [
    "webrtc",
    "peer-to-peer",
    "rendezvous",
    "presence"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.0.18"
  }
}
