# Bootstrap / signalling server
PORT=8787

# Default dual-stack listener. Use "0.0.0.0" only for IPv4, or "::1" for localhost IPv6.
HOST=::

# Set true only when you deliberately want an IPv6-only listener.
# RENDEZVOUS_IPV6_ONLY=false

# Persistent appointment/join/removal queue. Never contains photos.
# RENDEZVOUS_DATA_FILE=./data/signal-store.json

# ICE servers advertised to browsers. Include a self-hosted TURN if you want a
# fallback for difficult NATs. TURN forwards DTLS ciphertext only.
# RENDEZVOUS_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# RENDEZVOUS_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]

# Build-time client override when the page is served separately from /signal.
# VITE_SIGNAL_URL=wss://signal.example.com/signal
